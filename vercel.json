{
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/dashboard", "destination": "/FreeOfUgly_Dashboard.html" },
    { "source": "/shelf", "destination": "/shelf/index.html" },
    { "source": "/shelf/", "destination": "/shelf/index.html" },
    { "source": "/shelf/:slug", "destination": "/shelf/:slug.html" },
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/generate-slides.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/sync-instagram",
      "schedule": "0 14 * * *"
    }
  ]
}
