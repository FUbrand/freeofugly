{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/shelf",
      "destination": "/shelf/index.html"
    },
    {
      "source": "/shelf/",
      "destination": "/shelf/index.html"
    },
    {
      "source": "/shelf/:slug",
      "destination": "/shelf/:slug.html"
    }
  ]
}
